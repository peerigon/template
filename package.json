{
  "name": "@peerigon/template",
  "version": "1.0.0",
  "description": "Boilerplate template to kick start new projects at Peerigon",
  "keywords": [],
  "license": "MIT License",
  "author": "hello@peerigon.com",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "test": "run-p test:*",
    "test:format": "oxfmt --check .",
    "test:lint": "eslint --max-warnings 0 --cache .",
    "test:types": "tsc",
    "test:unit": "vitest --run",
    "vitest": "vitest"
  },
  "dependencies": {
    "env-var": "^7.5.0"
  },
  "devDependencies": {
    "@eslint/mcp": "^0.3.15",
    "@peerigon/configs": "^27.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pin-github-action": "^3.5.1",
    "secretlint": "^13.0.7",
    "ts-lsp-mcp": "0.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "ts-lsp-mcp": {
      "glob": "^13.0.6"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    }
  }
}
