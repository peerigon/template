#!/bin/bash
# .git/hooks/post-checkout

# Check if template remote exists
if ! git remote get-url template >/dev/null 2>&1; then
    # Use the same protocol as origin (SSH or HTTPS)
    case "$(git remote get-url origin 2>/dev/null)" in
        ssh://*|*@*:*) template_url=git@github.com:peerigon/template.git ;;
        *) template_url=https://github.com/peerigon/template.git ;;
    esac
    git remote add template "$template_url"
fi

git remote set-url --push template DISABLED
git config checkout.defaultRemote origin